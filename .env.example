# Runtime environment: development | production
ENV=development

# HTTP port the server listens on
PORT=8080

# Postgres connection string (see internal/database)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/go_v1?sslmode=disable

# Comma-separated list of allowed CORS origins, or * to allow all
CORS_ALLOWED_ORIGINS=*

# Optional static bearer token for the RequireBearerToken middleware.
# Leave empty to disable the check (dev only).
AUTH_BEARER_TOKEN=
